# Uploaded files: only images and video testimonials are ever served, nothing can execute.
Options -Indexes
Require all denied
<FilesMatch "(?i)\.(jpe?g|png|webp|mp4|m4v|mov|webm)$">
  Require all granted
</FilesMatch>
AddType video/mp4 .mp4 .m4v
AddType video/quicktime .mov
AddType video/webm .webm
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
