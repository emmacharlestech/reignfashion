# Admin area: no directory listings, open the inbox by default
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Live site: admin always over HTTPS (this folder's rules replace the site-wide ones)
  RewriteCond %{HTTP_HOST} ^(www\.)?reignfashionempire\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://reignfashionempire.com%{REQUEST_URI} [L,R=301]

  # Old addresses: /admin/index.php -> /admin/   and   /admin/gallery.php -> /admin/gallery
  # Only for normal page visits (GET), so form submissions are never redirected.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s(/[^?\s]*/)index\.php[?\s]
  RewriteRule ^ %1 [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s(/[^?\s]+)\.php[?\s]
  RewriteRule ^ %1 [R=301,L,NE]

  # Clean address: /admin/gallery serves gallery.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z-]+)$ $1.php [L]
</IfModule>

# Video testimonials: allow uploads up to ~64 MB in the admin area.
# (Apache with mod_php, e.g. XAMPP. PHP-FPM / LiteSpeed hosts read admin/.user.ini instead.)
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 70M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 70M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
